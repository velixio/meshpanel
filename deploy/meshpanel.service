[Unit]
Description=meshpanel: control panel for headscale
Documentation=https://github.com/meshpanel/meshpanel
After=network-online.target headscale.service
Wants=network-online.target

[Service]
Type=simple
User=meshpanel
Group=meshpanel
# Access to headscale's unix socket (unix_socket_permission "0770").
SupplementaryGroups=headscale
ExecStart=/usr/bin/meshpanel serve -c /etc/meshpanel/config.yaml
Restart=on-failure
RestartSec=3
StateDirectory=meshpanel
StateDirectoryMode=0750

# Hardening. meshpanel only needs its state directory, headscale's socket and,
# for DNS/policy editing, write access to /etc/headscale.
ProtectSystem=strict
ReadWritePaths=/var/lib/meshpanel -/etc/headscale -/var/run/headscale
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=no
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
# AF_NETLINK: the optional tailnet agent / browser SSH watch network changes.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Permit sudo to switch identity and initialize auditing. These are a ceiling,
# not ambient privileges for the unprivileged meshpanel process.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_AUDIT_WRITE
# NoNewPrivileges must stay off for sudo-based restarts or Headscale updates.
# Only when all sudo integrations are disabled (e.g. polkit-only restart/reload)
# may this be enabled and CapabilityBoundingSet cleared.
NoNewPrivileges=no

[Install]
WantedBy=multi-user.target
